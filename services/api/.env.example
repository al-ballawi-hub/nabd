# قاعدة البيانات — الافتراضي SQLite (بدون تنصيب)
DATABASE_URL=sqlite:///./nabd.db

# لاحقًا لمرحلة الإنتاج:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/nabd

CORS_ORIGINS=http://localhost:5173

# تُستخدم في مرحلة الـ OCR (لا تُحمّلها الآن):
# GEMINI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
