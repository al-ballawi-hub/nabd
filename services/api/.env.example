# قاعدة البيانات — الافتراضي SQLite (بدون تنصيب)
DATABASE_URL=sqlite:///./nabd.db

# لاحقًا لمرحلة الإنتاج:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/nabd

CORS_ORIGINS=http://localhost:5173

# DeepSeek AI — تحليل النص الطبي (بدون مفتاح سيعمل بوضع المحاكاة)
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# JWT — استبدل السر في الإنتاج بسر عشوائي قوي (32+ بايت)
# JWT_SECRET=change-me-to-a-long-random-secret
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=60

# تُستخدم في مرحلة الـ OCR (لا تُحمّلها الآن):
# GEMINI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
